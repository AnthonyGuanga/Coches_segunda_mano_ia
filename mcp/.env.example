# MCP Vehicle Safety Analysis System - Configuration
# Copia este archivo como .env y ajusta los valores según tu entorno

# ====== MCP Server Configuration ======
MCP_TOKEN=default-token
MCP_PORT=8000
MCP_HOST=0.0.0.0

# ====== NHTSA API Configuration ======
NHTSA_BASE_URL=https://api.nhtsa.gov/SafetyRatings

# ====== LLM Configuration (Opcional) ======
# Para llm_extract_vehicle_info - si no se configuran, usa regex fallback
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ====== SMTP Configuration ======
# Para desarrollo: usar localhost para simulación
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=vehicle-safety@mcp.local

# Para producción: configurar servidor SMTP real
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@yourdomain.com

# ====== Output Configuration ======
OUTPUT_DIR=./outputs

# ====== Logging Configuration ======
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ====== CORS Configuration ======
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:7860,http://127.0.0.1

# ====== Development Flags ======
DEBUG_MODE=true
MOCK_EXTERNAL_APIS=false